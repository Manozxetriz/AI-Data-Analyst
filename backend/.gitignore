## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environment
venv/
.venv/

# Environment variables
.env
.env.*
!.env.example

# FastAPI / Python
.pytest_cache/
.mypy_cache/

# Node
node_modules/
dist/
build/

# Vite
.vite/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

